# ──────────────────────────────────────────────
# Nexus Forge — Environment Configuration
# ──────────────────────────────────────────────

# Database (Neon Serverless PostgreSQL)
# Get your Connection String from the Neon.tech dashboard
DATABASE_URL="postgresql://neondb_owner:xxxxxxxx@ep-xxxxxx-xxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication (Better Auth + GitHub OAuth)
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# These must be the client credentials of the same GitHub App configured below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App collection and webhooks (shared personal tokens are rejected)
GITHUB_APP_ID=
# Store one form only. Base64 is convenient for hosted secret managers.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_API_VERSION=2022-11-28
# Override for GitHub Enterprise Server; defaults to https://api.github.com.
GITHUB_API_ROOT=
GITHUB_WEBHOOK_SECRET=
WEBHOOK_MAX_BODY_BYTES=1000000

# One-time owner backfill (used only by npm run backfill:project-owners)
LEGACY_PROJECT_OWNER_EMAIL=

# Support contact (required in production; validated by validateEnv)
SUPPORT_EMAIL=
SUPPORT_URL=
STATUS_URL=/api/health

# Release identity used for User-Agent strings and admission manifests.
# Set to the deployed version in production; defaults to "dev" locally.
APP_CODE_VERSION=dev

# Analysis
ANALYSIS_MAX_CONTENT_LENGTH=100000
MAX_SOURCES_PER_PROJECT=20
ANALYSIS_JOB_LEASE_MS=60000
# Optional stable identifier; workers generate a unique value when absent.
WORKER_ID=

# Groq
# Get your API key from https://console.groq.com/keys
# LLM-assisted stages run through Groq when configured.
# Default model: llama-3.3-70b-versatile
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Comma-separated rolling-deploy allowlist. Include both old and new persisted models during rollout.
GROQ_ALLOWED_MODELS=llama-3.3-70b-versatile
# Set to true to disable all provider inference immediately. Deterministic baselines still run.
INFERENCE_DISABLED=false
# Set to true to disable content ingestion (sources, repository/PR collection). Lifecycle events still processed.
INGESTION_DISABLED=false
AI_MAX_TOKENS_PER_CALL=20000
AI_DAILY_USER_TOKEN_BUDGET=250000
AI_DAILY_PROJECT_TOKEN_BUDGET=150000
# Personal provider keys (BYOK). Required to enable Settings -> AI models.
# Must be at least 32 characters; generate with: openssl rand -hex 32
LLM_USER_KEY_MASTER_SECRET=

# Experimental quality orchestrator (always disabled in production)
QUALITY_ORCHESTRATOR_ENABLED=false
QUALITY_ORCHESTRATOR_ALLOWED_EMAILS=
# Required by npm run quality:sandbox; pin an approved image by immutable digest.
QUALITY_SANDBOX_IMAGE=

# Stripe Billing (self-service subscriptions; Connect is not used)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PILOT_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
# Stripe Tax must be evaluated per selling jurisdiction with required registrations
# before launch; enabling automatic tax alone is not sufficient.
STRIPE_TAX_ENABLED=false

# Enterprise (P6)
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SCIM_TOKEN=
DATA_REGION=us
IP_ALLOWLIST=

# Database pool and timeouts
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
# Worker capacity
WORKER_CONCURRENCY=2
WORKER_REPLICAS=1

# Environment
NODE_ENV=development
