generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AnalysisRunStatus {
  QUEUED
  RUNNING
  CANCEL_REQUESTED
  CANCELLED
  SUCCEEDED
  FAILED
}

enum AnalysisStageName {
  KNOWLEDGE
  REPOSITORY
  WORKFLOW
  RELEASE
  PROOF
}

enum AnalysisStageStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
}

enum JobKind {
  ANALYSIS
  WEBHOOK
}

enum AiReservationStatus {
  RESERVED
  RECONCILED
  RELEASED
}

enum JobStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  DEAD
  CANCELLED
}

enum ScorecardKind {
  REPOSITORY_MATURITY
  RELEASE_READINESS
  PROOF_COMPLETENESS
}

enum CriterionStatus {
  PASS
  FAIL
  UNKNOWN
  NOT_APPLICABLE
}

enum EvidenceConfidence {
  HIGH
  MEDIUM
  LOW
}

enum EvidenceProvenance {
  SOURCE_SNAPSHOT
  REPOSITORY_SNAPSHOT
  PULL_REQUEST_SNAPSHOT
  GENERATED_ARTIFACT
  WEBHOOK_PAYLOAD
}

model Project {
  id                       String    @id @default(cuid())
  ownerId                  String?
  name                     String
  goal                     String    @default("")
  repoUrl                  String    @default("")
  prUrl                    String    @default("")
  githubRepositoryFullName String?
  githubRepositoryId       String?
  githubInstallationId     String?
  githubBindingStatus      String    @default("unbound")
  githubBindingDisabledAt  DateTime?
  githubInstallationAccountId             String?
  githubInstallationAccountLogin          String?
  githubInstallationAccountType           String?
  githubInstallationRepositorySelection   String?
  githubInstallationPermissions           Json?
  githubAuthorizedByGithubUserId           String?
  githubAuthorizedByUserId                 String?
  githubBindingLastReconciledAt            DateTime?
  githubBindingReconciliationError         String?
  lastWebhookDeliveryAt              DateTime?
  githubRepositoryPrivate              Boolean?
  externalInferenceEnabled             Boolean   @default(false)
  externalInferenceAuthorizedBy        String?
  externalInferenceAuthorizedAt        DateTime?
  externalInferenceAckVersion          String?
  ingestionSuspendedAt                 DateTime?
  ingestionSuspendReason               String?
  inferenceSuspendedAt                 DateTime?
  inferenceSuspendReason               String?
  excludedPaths                  Json     @default("[]")
  editRevision               Int       @default(0)
  status                   String    @default("idle")
  activeAnalysisRunId      String?   @unique
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  owner               User?                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  sources             Source[]
  knowledge           KnowledgeSummary?
  repoAnalysis        RepoAnalysis?
  workflow            Workflow?
  releaseReport       ReleaseReport?
  proofPack           ProofPack?
  webhookDeliveries   WebhookDelivery[]
  aiUsageEvents       AiUsageEvent[]
  analysisRuns        AnalysisRun[]        @relation("ProjectAnalysisRuns")
  activeAnalysisRun   AnalysisRun?         @relation("ActiveAnalysisRun", fields: [activeAnalysisRunId], references: [id], onDelete: SetNull)
  pullRequestSnapshots PullRequestSnapshot[]
  jobs                Job[]
  artifacts           ArtifactVersion[]
  evidenceRecords     EvidenceRecord[]
  scorecards          Scorecard[]
  repositorySnapshots RepositorySnapshot[]
  githubOnboardingStates GitHubOnboardingState[]
  repositoryPermissionSnapshots RepositoryPermissionSnapshot[]
  secretOverrides SecretOverride[]
  acceptedBaselines AcceptedBaseline[]
  schedule PilotSchedule?
  baselineDigests BaselineDigest[]
  profileRevisions ProfileRevision[]
  artifactReviews ArtifactReview[]
  triggerSettings TriggerSettings?
  findings Finding[]
  shareLinks ShareLink[]
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([githubInstallationId, githubRepositoryFullName])
  @@unique([githubInstallationId, githubRepositoryId])
  @@index([ownerId, updatedAt])
  @@index([githubInstallationId])
}

model PullRequestSnapshot {
  id                 String   @id @default(cuid())
  projectId          String
  analysisRunId      String   @unique
  repositoryFullName String
  pullNumber         Int
  headSha            String
  baseSha            String
  mergedCommitSha    String?
  fileCount          Int      @default(0)
  checkCount         Int      @default(0)
  reviewCount        Int      @default(0)
  collectorVersion   String
  complete           Boolean  @default(false)
  diagnostics        Json
  observedAt         DateTime
  createdAt          DateTime @default(now())

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysisRun AnalysisRun  @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  files       PullRequestFile[]
  checks      PullRequestCheck[]
  reviews     PullRequestReview[]

  @@index([projectId, createdAt])
}

model PullRequestFile {
  id         String @id @default(cuid())
  snapshotId String
  path       String
  additions  Int    @default(0)
  deletions  Int    @default(0)
  status     String @default("collected")

  snapshot PullRequestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, path])
  @@index([snapshotId])
}

model PullRequestCheck {
  id         String  @id @default(cuid())
  snapshotId String
  name       String
  status     String
  conclusion String?

  snapshot PullRequestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
}

model PullRequestReview {
  id          String  @id @default(cuid())
  snapshotId  String
  reviewId    String
  state       String
  submittedAt String?

  snapshot PullRequestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, reviewId])
  @@index([snapshotId])
}

model RepositorySnapshot {
  id                 String   @id @default(cuid())
  projectId          String
  analysisRunId      String   @unique
  installationId     String
  repositoryId       String
  repositoryFullName String
  commitSha          String
  treeSha            String
  collectorVersion   String
  complete           Boolean  @default(false)
  truncated          Boolean  @default(false)
  diagnostics        Json
  entryCount         Int      @default(0)
  sourceFileCount    Int      @default(0)
  decodedBytes       Int      @default(0)
  observedAt         DateTime
  createdAt          DateTime @default(now())

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  analysisRun AnalysisRun      @relation(fields: [analysisRunId], references: [id], onDelete: Restrict)
  files       RepositoryFile[]

  @@unique([projectId, repositoryId, commitSha, collectorVersion])
  @@index([projectId, createdAt])
}

model RepositoryFile {
  id          String   @id @default(cuid())
  snapshotId  String
  path        String
  mode        String
  objectType  String
  blobSha     String?
  size        Int?
  status      String
  language    String?
  content     String?
  contentHash String?
  diagnostic  String?
  createdAt   DateTime @default(now())

  snapshot RepositorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, path])
  @@index([snapshotId, status])
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  accounts      Account[]
  projects      Project[]
  auditLogs     AuditLog[]
  aiUsageEvents AiUsageEvent[]
  analysisRuns  AnalysisRun[]
  jobs          Job[]
  githubOnboardingStates GitHubOnboardingState[]
  organizations Organization[]
  memberships   Membership[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubOnboardingStates GitHubOnboardingState[]

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model GitHubOnboardingState {
  id                       String   @id
  tokenHash                String   @unique
  projectId                String
  userId                   String
  sessionId                String
  status                   String   @default("PENDING")
  expiresAt                DateTime
  installationId           String?
  installationAccountId    String?
  installationAccountLogin String?
  installationAccountType  String?
  repositorySelection      String?
  installationPermissions  Json?
  githubUserId             String?
  callbackVerifiedAt       DateTime?
  consumedAt               DateTime?
  failureCode              String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([projectId, status, expiresAt])
  @@index([userId, sessionId, status])
}

model RepositoryPermissionSnapshot {
  id                      String   @id @default(cuid())
  projectId               String
  installationId          String
  repositoryId            String
  repositoryFullName      String
  installationPermissions Json
  userRepositoryPermissions Json
  repositorySelection     String
  observedAt              DateTime
  source                  String
  createdAt               DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, observedAt])
  @@index([installationId, repositoryId, observedAt])
}

model GitHubInstallationLifecycle {
  installationId String   @id
  status         String
  deliveryId     String
  revision       Int      @default(1)
  observedAt     DateTime
  updatedAt      DateTime @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Source {
  id                String   @id @default(cuid())
  projectId         String
  type              String
  title             String   @default("")
  rawContent        String
  documentId        String   @default("")
  quarantineStatus  String   @default("CLEAR")
  quarantineReason  String?
  scannerVersion    String?
  createdAt         DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model SecretOverride {
  id          String   @id @default(cuid())
  projectId   String
  contentHash String
  reason      String
  authorizedBy String
  authorizedAt DateTime @default(now())
  expiresAt   DateTime?
  scannerVersion String
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, contentHash])
  @@index([projectId, createdAt])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  memberships Membership[]
  invitations Invitation[]
  projects    Project[]
  tenantKey   TenantKey?
  deletionRequests DeletionRequest[]
  policyPacks PolicyPack[]
  repositoryGroups RepositoryGroup[]

  @@index([ownerId])
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("VIEWER")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           String    @default("VIEWER")
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model TenantKey {
  id             String    @id @default(cuid())
  organizationId String    @unique
  keyId          String    @unique
  keyMaterial    String?
  createdAt      DateTime  @default(now())
  destroyedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model DeletionRequest {
  id             String    @id @default(cuid())
  organizationId String?
  projectId      String?
  scope          String
  status         String    @default("PENDING")
  requestedBy    String
  reason         String?
  tombstone      Json?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([projectId, status])
}

model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String
  userId    String
  projectId String
  runId     String
  createdAt DateTime @default(now())

  @@unique([key, userId, projectId])
  @@index([projectId, createdAt])
}

model AcceptedBaseline {
  id        String   @id @default(cuid())
  projectId String
  runId     String   @unique
  actorId   String
  createdAt DateTime @default(now())

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run     AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model PilotSchedule {
  id        String    @id @default(cuid())
  projectId String    @unique
  enabled   Boolean   @default(true)
  cadence   String    @default("WEEKLY")
  nextRunAt DateTime
  lastRunAt DateTime?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model TriggerSettings {
  id                   String   @id @default(cuid())
  projectId            String   @unique
  debounceMinutes      Int      @default(5)
  quietStartHour       Int?
  quietEndHour         Int?
  materialityThreshold Int      @default(1)
  digestEnabled        Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Finding {
  id             String    @id @default(cuid())
  projectId      String
  criterionId    String
  status         String    @default("OPEN")
  ownerId        String?
  dueAt          DateTime?
  evidenceIds    Json      @default("[]")
  externalIssue  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments   FindingComment[]
  waivers    FindingWaiver[]
  resolutions FindingResolution[]

  @@unique([projectId, criterionId])
  @@index([projectId, status])
}

model FindingComment {
  id        String   @id @default(cuid())
  findingId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId, createdAt])
}

model FindingWaiver {
  id             String    @id @default(cuid())
  findingId      String
  reason         String
  approverId     String
  scope          String    @default("criterion")
  expiresAt      DateTime?
  reopenOnCommit Boolean   @default(true)
  createdAt      DateTime  @default(now())

  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId, createdAt])
}

model FindingResolution {
  id          String   @id @default(cuid())
  findingId   String
  commitSha   String
  verifiedAt  DateTime @default(now())
  verifierId  String

  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId, verifiedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  runId     String?
  kind      String
  title     String
  body      String   @default("")
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

model BillingCustomer {
  id             String   @id @default(cuid())
  organizationId String?  @unique
  userId         String?  @unique
  stripeCustomerId String @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Subscription {
  id                 String    @id @default(cuid())
  organizationId     String?
  userId             String?
  stripeSubscriptionId String  @unique
  plan               String
  status             String
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([organizationId, status])
  @@index([userId, status])
}

model EntitlementSnapshot {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  revision       Int
  allowances     Json
  source         String   @default("stripe")
  createdAt      DateTime @default(now())

  @@index([organizationId, revision])
  @@index([userId, revision])
}

model UsageLedger {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  periodStart    DateTime
  runs           Int      @default(0)
  exports        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId, periodStart])
}

model BillingWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
}

model ShareLink {
  id         String    @id @default(cuid())
  projectId  String
  runId      String?
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model PolicyPack {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  thresholds     Json
  version        Int      @default(1)
  active         Boolean  @default(true)
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name, version])
  @@index([organizationId, active])
}

model RepositoryGroup {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  pattern        String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

model ServiceAccount {
  id             String    @id @default(cuid())
  organizationId String?
  userId         String?
  name           String
  scopes         Json      @default("[]")
  tokenHash      String    @unique
  lastRotatedAt  DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([userId])
}

model OutboundWebhook {
  id             String   @id @default(cuid())
  organizationId String?
  projectId      String?
  url            String
  secret         String
  events         Json     @default("[]")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([projectId])
}

model OutboundDelivery {
  id          String    @id @default(cuid())
  webhookId   String
  eventId     String    @unique
  event       String
  payloadHash String
  status      String    @default("pending")
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([webhookId, createdAt])
}

model ProfileRevision {
  id        String   @id @default(cuid())
  projectId String?
  name      String
  preset    String
  controls  Json
  version   Int
  actorId   String
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId, createdAt])
}

model RunTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  controls    Json
  version     Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BaselineDigest {
  id             String   @id @default(cuid())
  projectId      String
  runId          String
  baselineRunId  String
  additions      Json     @default("[]")
  removals       Json     @default("[]")
  statusChanges  Json     @default("[]")
  unknowns       Json     @default("[]")
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, runId])
  @@index([projectId, createdAt])
}

model ArtifactReview {
  id            String   @id @default(cuid())
  projectId     String
  artifactKind  String
  status        String   @default("DRAFT")
  scope         String   @default("internal")
  reason        String   @default("")
  authorId      String
  baselineRunId String?
  parentId      String?
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, artifactKind, createdAt])
}

model PilotEntitlement {
  id             String    @id @default(cuid())
  organizationId String?   @unique
  userId         String?   @unique
  plan           String    @default("pilot")
  maxRunsPerDay  Int       @default(10)
  maxExportsPerDay Int     @default(50)
  maxProjects    Int       @default(50)
  revision       Int       @default(1)
  expiresAt      DateTime?
  suspended      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model EntitlementRevision {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  revision       Int
  allowances     Json
  actorId        String
  createdAt      DateTime @default(now())

  @@index([organizationId, revision])
  @@index([userId, revision])
}

model EntitlementUsage {
  id             String   @id @default(cuid())
  organizationId String   @default("")
  userId         String   @default("")
  periodStart    DateTime
  runsUsed       Int      @default(0)
  exportsUsed    Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId, periodStart])
  @@index([periodStart])
}

model KnowledgeSummary {
  id                     String   @id @default(cuid())
  projectId              String   @unique
  mainTopic              String   @default("")
  keyConcepts            String   @default("[]")
  implementationPatterns String   @default("[]")
  buildableTasks         String   @default("[]")
  warningsOrPitfalls     String   @default("[]")
  termsToUnderstand      String   @default("[]")
  sourceEvidence         String   @default("[]")
  recommendedNextAction  String   @default("")
  rawOutput              String   @default("")
  createdAt              DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model RepoAnalysis {
  id                     String   @id @default(cuid())
  projectId              String   @unique
  repoUrl                String   @default("")
  detectedStack          String   @default("[]")
  architectureSummary    String   @default("")
  importantFiles         String   @default("[]")
  likelyFeatureLocations String   @default("[]")
  testLocations          String   @default("[]")
  setupQuality           String   @default("")
  missingItems           String   @default("[]")
  risks                  String   @default("[]")
  maturityScore          Int      @default(0)
  scoreCompleteness      Float    @default(0)
  scoreStatus            String   @default("unknown")
  scorecardVersion       String   @default("")
  recommendedFixes       String   @default("[]")
  rawOutput              String   @default("")
  graphJson              String   @default("null")
  createdAt              DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Workflow {
  id                          String   @id @default(cuid())
  projectId                   String   @unique
  title                       String   @default("")
  objective                   String   @default("")
  tasksJson                   String   @default("[]")
  acceptanceCriteria          String   @default("[]")
  completedAcceptanceCriteria String   @default("[]")
  testPlan                    String   @default("")
  expectedFiles               String   @default("[]")
  reviewChecklist             String   @default("[]")
  rawOutput                   String   @default("")
  humanState                  Json     @default("{}")
  humanEdited                 Boolean  @default(false)
  revision                    Int      @default(0)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ReleaseReport {
  id                          String   @id @default(cuid())
  projectId                   String   @unique
  releaseScore                Int      @default(0)
  scoreCompleteness           Float    @default(0)
  scoreStatus                 String   @default("unknown")
  scorecardVersion            String   @default("")
  decision                    String   @default("")
  topRisks                    String   @default("[]")
  missingTests                String   @default("[]")
  missingDocs                 String   @default("[]")
  configOrEnvIssues           String   @default("[]")
  backwardCompatibility       String   @default("[]")
  releaseChecklist            String   @default("[]")
  releaseNotesDraft           String   @default("")
  recommendedFixesBeforeMerge String   @default("[]")
  rawOutput                   String   @default("")
  createdAt                   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProofPack {
  id                   String   @id @default(cuid())
  projectId            String   @unique
  portfolioSummary     String   @default("")
  resumeBullet         String   @default("")
  demoVideoScript      String   @default("")
  interviewExplanation String   @default("")
  linkedinPost         String   @default("")
  proofScore           Int      @default(0)
  scoreCompleteness    Float    @default(0)
  scoreStatus          String   @default("unknown")
  scorecardVersion     String   @default("")
  missingProofItems    String   @default("[]")
  rawOutput            String   @default("")
  createdAt            DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model GitHubLifecycleDelivery {
  id             String   @id @default(cuid())
  deliveryId     String   @unique
  event          String
  action         String
  installationId String
  payloadSha256  String
  payload        Json
  receivedAt     DateTime @default(now())

  @@index([installationId, receivedAt])
}

model WebhookDelivery {
  id            String    @id @default(cuid())
  deliveryId    String    @unique
  projectId     String
  event         String
  action        String    @default("")
  status        String    @default("received")
  eventKey      String    @unique
  payloadSha256 String
  payload       Json
  errorCode     String?
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?

  attempts      Int       @default(0)
  lastErrorCode String?
  lastErrorAt   DateTime?

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobs      Job[]
  artifacts ArtifactVersion[]

  @@index([projectId, receivedAt])
}

model AnalysisRun {
  id                 String            @id @default(cuid())
  projectId          String
  ownerId            String
  status             AnalysisRunStatus @default(QUEUED)
  processingMode     String            @default("INFERENCE_ENABLED")
  inferenceStatus    String            @default("PENDING")
  admissionManifest  Json              @default("{}")
  admissionDigest    String?
  inputSnapshot      Json
  inputHash          String
  commitSha          String?
  pipelineVersion    String
  promptVersion      String
  modelConfigVersion String
  modelConfig        Json
  attemptCount       Int               @default(0)
  failureClass       String?
  failureCode        String?
  failureMessage     String?
  inputTokens        Int               @default(0)
  outputTokens       Int               @default(0)
  totalTokens        Int               @default(0)
  queuedAt           DateTime          @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  ledgerSealedAt     DateTime?
  cancelRequestedAt  DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  project            Project             @relation("ProjectAnalysisRuns", fields: [projectId], references: [id], onDelete: Restrict)
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  activeForProject   Project?            @relation("ActiveAnalysisRun")
  acceptedBaseline   AcceptedBaseline?
  stages             AnalysisStageRun[]
  jobs               Job[]
  artifacts          ArtifactVersion[]
  evidenceRecords    EvidenceRecord[]
  scorecards         Scorecard[]
  repositorySnapshot RepositorySnapshot?
  pullRequestSnapshot PullRequestSnapshot?

  @@index([projectId, createdAt])
  @@index([ownerId, createdAt])
  @@index([id, projectId, ownerId])
  @@index([status, queuedAt])
}

model AnalysisStageRun {
  id                 String              @id @default(cuid())
  analysisRunId      String
  stage              AnalysisStageName
  ordinal            Int
  status             AnalysisStageStatus @default(PENDING)
  attemptCount       Int                 @default(0)
  inputHash          String?
  outputHash         String?
  inputTokens        Int                 @default(0)
  outputTokens       Int                 @default(0)
  totalTokens        Int                 @default(0)
  failureClass       String?
  failureCode        String?
  failureMessage     String?
  promptId           String?
  promptVersion      String?
  agentSchemaVersion String?
  requestedProvider  String?
  requestedModel     String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  analysisRun     AnalysisRun       @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  artifacts       ArtifactVersion[]
  evidenceRecords EvidenceRecord[]

  @@unique([analysisRunId, stage])
  @@unique([analysisRunId, ordinal])
  @@index([analysisRunId, status])
}

model Job {
  id                String    @id @default(cuid())
  kind              JobKind
  status            JobStatus @default(QUEUED)
  projectId         String
  ownerId           String
  analysisRunId     String?
  webhookDeliveryId String?
  payload           Json?
  attemptCount      Int       @default(0)
  maxAttempts       Int       @default(5)
  availableAt       DateTime  @default(now())
  leaseOwner        String?
  leaseToken        String?   @unique
  leaseExpiresAt    DateTime?
  heartbeatAt       DateTime?
  failureClass      String?
  failureCode       String?
  failureMessage    String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  analysisRun     AnalysisRun?     @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  webhookDelivery WebhookDelivery? @relation(fields: [webhookDeliveryId], references: [id], onDelete: Cascade)

  @@unique([analysisRunId])
  @@unique([webhookDeliveryId])
  @@index([status, availableAt])
  @@index([leaseExpiresAt])
  @@index([projectId, createdAt])
  @@index([id, projectId, ownerId, kind])
}

model ArtifactVersion {
  id                 String   @id @default(cuid())
  projectId          String
  analysisRunId      String?
  analysisStageRunId String?
  webhookDeliveryId  String?
  kind               String
  schemaVersion      Int      @default(1)
  content            Json
  contentHash        String
  promptId           String?
  promptVersion      String?
  agentSchemaVersion String?
  requestedProvider  String?
  requestedModel     String?
  createdAt          DateTime @default(now())

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysisRun      AnalysisRun?      @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  analysisStageRun AnalysisStageRun? @relation(fields: [analysisStageRunId], references: [id], onDelete: Cascade)
  webhookDelivery  WebhookDelivery?  @relation(fields: [webhookDeliveryId], references: [id], onDelete: Cascade)

  @@unique([analysisRunId, kind, schemaVersion])
  @@unique([webhookDeliveryId, kind, schemaVersion])
  @@index([projectId, createdAt])
  @@index([analysisStageRunId])
}

model EvidenceRecord {
  id                 String             @id @default(cuid())
  projectId          String
  analysisRunId      String
  analysisStageRunId String?
  stableEvidenceId   String
  evidenceType       String
  source             String
  collectorId        String
  collectorVersion   String
  observedAt         DateTime
  repositoryFullName String?
  commitSha          String?
  path               String?
  lineStart          Int?
  lineEnd            Int?
  checkId            String?
  contentHash        String
  facts              Json
  provenance         EvidenceProvenance
  confidence         EvidenceConfidence
  createdAt          DateTime           @default(now())

  project          Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  analysisRun      AnalysisRun               @relation(fields: [analysisRunId], references: [id], onDelete: Restrict)
  analysisStageRun AnalysisStageRun?         @relation(fields: [analysisStageRunId], references: [id], onDelete: Restrict)
  criterionLinks   CriterionResultEvidence[]

  @@unique([analysisRunId, stableEvidenceId])
  @@index([projectId, analysisRunId, evidenceType])
  @@index([contentHash])
}

model Scorecard {
  id                      String        @id @default(cuid())
  projectId               String
  analysisRunId           String
  kind                    ScorecardKind
  version                 String
  score                   Int?
  completenessRatio       Float
  completenessBasisPoints Int
  totalWeight             Int
  knownWeight             Int
  passedWeight            Int
  applicableCount         Int
  evaluatedCount          Int
  passCount               Int
  failCount               Int
  unknownCount            Int
  notApplicableCount      Int
  createdAt               DateTime      @default(now())

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  analysisRun      AnalysisRun       @relation(fields: [analysisRunId], references: [id], onDelete: Restrict)
  criterionResults CriterionResult[]

  @@unique([analysisRunId, kind, version])
  @@index([projectId, kind, createdAt])
}

model CriterionResult {
  id               String          @id @default(cuid())
  scorecardId      String
  criterionId      String
  criterionVersion String
  status           CriterionStatus
  weight           Int
  reasonCode       String
  reason           String
  evaluatedAt      DateTime
  createdAt        DateTime        @default(now())

  scorecard     Scorecard                 @relation(fields: [scorecardId], references: [id], onDelete: Restrict)
  evidenceLinks CriterionResultEvidence[]

  @@unique([scorecardId, criterionId, criterionVersion])
  @@index([scorecardId, status])
}

model CriterionResultEvidence {
  criterionResultId String
  evidenceRecordId  String
  createdAt         DateTime @default(now())

  criterionResult CriterionResult @relation(fields: [criterionResultId], references: [id], onDelete: Restrict)
  evidenceRecord  EvidenceRecord  @relation(fields: [evidenceRecordId], references: [id], onDelete: Restrict)

  @@id([criterionResultId, evidenceRecordId])
  @@index([evidenceRecordId])
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

model AiBudgetBucket {
  key            String   @id
  periodStart    DateTime
  usedTokens     Int      @default(0)
  reservedTokens Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@index([periodStart])
}

model AiTokenReservation {
  id               String              @id @default(cuid())
  userId           String
  projectId        String?
  userBucketKey    String
  projectBucketKey String?
  operation        String
  reservedTokens   Int
  actualTokens     Int?
  status           AiReservationStatus @default(RESERVED)
  createdAt        DateTime            @default(now())
  settledAt        DateTime?
  usageEvent       AiUsageEvent?

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

model AiUsageEvent {
  id                String   @id @default(cuid())
  userId            String?
  projectId         String?
  operation         String
  provider          String
  requestedProvider String
  requestedModel    String
  responseProvider  String?
  responseModel     String?
  success           Boolean
  errorCode         String?
  latencyMs         Int
  pipelineVersion   String?
  promptId          String?
  promptVersion     String?
  schemaVersion     String?
  finishReason      String?
  responseId        String?
  attemptCount      Int?
  reservationId     String?  @unique
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  createdAt         DateTime @default(now())

  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reservation AiTokenReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  action         String
  details        String   @default("")
  projectId      String   @default("")
  userId         String?
  organizationId String?
  targetId       String?
  requestId      String?
  interface      String   @default("api")
  outcome        String   @default("success")
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
}
